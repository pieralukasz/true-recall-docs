---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Email Confirmation" description="Confirm your True Recall email address">
	<div class="confirm-container">
		<div id="loading">
			<h1>Confirming…</h1>
			<p>Please wait while we verify your email.</p>
		</div>
		<div id="error-state" style="display:none">
			<h1>Confirmation Failed</h1>
			<p id="error-message" class="error-message"></p>
			<a id="retry" href="/login" class="btn">Go to Sign In</a>
		</div>
	</div>
</BaseLayout>

<script>
	import { supabase } from "../../lib/supabase";

	const params = new URLSearchParams(window.location.search);
	const code = params.get("code");
	const tokenHash = params.get("token_hash");
	const type = params.get("type");
	const next = params.get("next") ?? nextFromRedirectTo(params.get("redirect_to"));
	const safeNext = next?.startsWith("/auth/plugin?") ? next : "/dashboard";

	const loadingEl = document.getElementById("loading")!;
	const errorState = document.getElementById("error-state")!;
	const errorMessage = document.getElementById("error-message")!;
	const retry = document.getElementById("retry") as HTMLAnchorElement;
	// A plugin sign-in that failed should restart on the plugin page, which
	// still knows the device it was authorizing.
	if (safeNext.startsWith("/auth/plugin?")) retry.href = safeNext;

	/**
	 * The magic-link email carries the requested redirect as `redirect_to`
	 * (a token-hash link never passes through Supabase, so nothing else
	 * forwards it). Only its `next` parameter is trusted, and only when the
	 * redirect points at this very page.
	 */
	function nextFromRedirectTo(value: string | null): string | null {
		if (!value) return null;
		try {
			const url = new URL(value, window.location.origin);
			return url.pathname === "/auth/confirm" ? url.searchParams.get("next") : null;
		} catch {
			return null;
		}
	}

	function showError(msg: string) {
		loadingEl.style.display = "none";
		errorMessage.textContent = msg;
		errorState.style.display = "block";
	}

	function explain(message: string): string {
		if (/code verifier/i.test(message)) {
			return "This link was opened in a different browser than the one that asked for it, so it could not finish signing you in. Request a new link and open it on this device.";
		}
		return message;
	}

	async function handleConfirm() {
		if (code) {
			const { error } = await supabase.auth.exchangeCodeForSession(code);
			if (error) {
				showError(explain(error.message));
				return;
			}
			window.location.href = safeNext;
		} else if (tokenHash && type) {
			const { error } = await supabase.auth.verifyOtp({
				token_hash: tokenHash,
				type: type as "email" | "recovery" | "magiclink",
			});
			if (error) {
				showError(error.message);
				return;
			}
			window.location.href = safeNext;
		} else {
			showError("This link is invalid or has expired. Please request a new sign-in link.");
		}
	}

	handleConfirm();
</script>

<style>
	.confirm-container {
		max-width: 400px;
		margin: 6rem auto;
		text-align: center;
	}

	.confirm-container h1 {
		font-size: 1.75rem;
		margin-bottom: 1rem;
	}

	.confirm-container p {
		color: var(--sl-color-gray-3);
		margin-bottom: 1.5rem;
	}

	.error-message {
		background: color-mix(in srgb, var(--tr-color-error) 10%, transparent);
		border: 1px solid var(--tr-color-error);
		color: var(--tr-color-error);
		padding: 0.75rem 1rem;
		border-radius: var(--tr-radius-sm);
		font-size: 0.875rem;
	}

	.btn {
		display: inline-block;
		padding: 0.75rem 1.5rem;
		background: var(--sl-color-accent);
		color: var(--sl-color-white);
		border: none;
		border-radius: var(--tr-radius-sm);
		font-size: 1rem;
		font-weight: 500;
		cursor: pointer;
		transition: filter 0.2s;
		text-decoration: none;
	}

	.btn:hover {
		filter: brightness(1.1);
		text-decoration: none;
	}
</style>
